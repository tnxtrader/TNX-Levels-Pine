//@version=6
// T3 Edge Lab — executes one candidate of program3_candidates.csv (Pool L or Pool N) with the execution
// rules of FRAMEWORK.html (B.3 execution, B.4 barriers, B.7 T3, B.8 session clock, Part C rules).
// Every rule is the framework's rule; the trades follow B.3 and B.4 with the TradingView intrabar path (B.4, the
// research engine's option pessimistic = False).
// Chart: the instrument's continuous contract, 30-minute bars, full electronic (ETH) session, exchange time zone CT.
// Properties: commission = cash per contract per side = the contract's fees round trip / 2 (MNQ/MYM 0.61, MCL 0.86,
// MGC 0.96, SIL 1.36, NQ/YM 1.89, CL 2.02, GC/SI 2.16); slippage = 1 tick.
strategy("T3 Edge Lab", shorttitle = "T3 Edge Lab", overlay = true, pyramiding = 0, calc_on_every_tick = false,
     process_orders_on_close = false, default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.61, slippage = 1,
     use_bar_magnifier = false, max_bars_back = 500)

// ───────────────────────────── inputs: the candidate (one row of program3_candidates.csv)
gP = "Candidate"
poolIn = input.string("N", "Pool", options = ["N", "L"], group = gP)
sideIn = input.string("Long", "Side", options = ["Long", "Short"], group = gP)

gN = "Pool N (trigger + T3 context + market context)"
nTrig = input.string("ORB_BREAK_30", "Trigger", group = gN, options = ["ORB_DIR_30", "ORB_BREAK_30", "ORB_BREAK_60",
     "ORB_RETEST_30", "IMOM_DAY", "IMOM_FIRST", "IMOM_LARGE", "NB_10", "NB_15", "VBO_025", "VBO_050", "GAP_CONTINUE",
     "GAP_FADE", "VWAP_RECLAIM", "VWAP_PULLBACK", "SLOT_20", "SLOT_40", "NR4_DAY_BREAK", "NR7_DAY_BREAK", "PDH_BREAK",
     "PDL_RECLAIM", "T3_PULLBACK_BREAK_D", "T3_TOUCH_3BAR_D", "MR_VWAP_2", "MR_SMA20_2_D"])
nT3Ctx = input.string("NONE", "T3 context", group = gN, options = ["NONE", "T3_SLOPE_UP_F", "T3_SLOPE_UP_S", "T3_SIDE_F",
     "T3_SIDE_S", "T3_NEAR_F", "T3_NEAR_S", "T3_STRONG_F", "T3_STRONG_S", "T3_STACK"])
nMktCtx = input.string("NONE", "Market context", group = gN, options = ["NONE", "VOL_HIGH", "VOL_NOT_LOW", "DAILY_TREND",
     "MARKET_AGREE"])
fastLen = input.int(5, "FAST T3 length", minval = 1, group = gN)
fastVF  = input.float(0.7, "FAST T3 volume factor", minval = 0.0, maxval = 1.0, step = 0.1, group = gN)
slowLen = input.int(13, "SLOW T3 length", minval = 1, group = gN)
slowVF  = input.float(0.7, "SLOW T3 volume factor", minval = 0.0, maxval = 1.0, step = 0.1, group = gN)

gL = "Pool L (trigger + filter + T3 of the row)"
lTrig = input.string("T3_CLOSE_CROSS", "Trigger", group = gL, options = ["T3_BODY_CROSS", "T3_CLOSE_CROSS", "T3_TWO_CLOSE",
     "T3_THREE_CLOSE", "T3_WICK_RECLAIM", "T3_CLEAN_RECLAIM", "T3_CROSS_RANGE_BREAK", "T3_PULLBACK_BREAK", "T3_TOUCH_3BAR_TREND",
     "T3_SLOPE_TURN", "T3_DISTANCE_RELEASE", "DONCHIAN_3", "DONCHIAN_5", "DONCHIAN_8", "DONCHIAN_12", "DONCHIAN_20",
     "PREVBAR_BREAK", "INSIDE_BAR_BREAK", "COMPRESSION_BREAK_3", "COMPRESSION_BREAK_5", "COMPRESSION_BREAK_8",
     "RANGE_EXPANSION_CLOSE", "MOMENTUM_3", "MOMENTUM_6", "THREE_BAR_CONTINUATION", "GAP_CONTINUATION", "TWO_BAR_REVERSAL",
     "OUTSIDE_BAR_REVERSAL", "SWEEP_RECLAIM_5", "SWEEP_RECLAIM_10", "MEAN_REVERSION_2", "MEAN_REVERSION_3",
     "ORB_OPEN_BAR", "ORB_BREAK", "IMOM_DAY", "IMOM_FIRST"])
lFilt = input.string("NONE", "Filter", group = gL, options = ["NONE", "BODY_35", "BODY_55", "BODY_70", "CLV_55", "CLV_65",
     "CLV_75", "DIRECTIONAL_BODY", "FAVOURABLE_WICK_30", "NO_ADVERSE_WICK_20", "GAP_ALIGNED_010", "MOMENTUM_2",
     "PREV_OPPOSITE_CANDLE", "RANGE_COMPRESS_060", "RANGE_EXPAND_125", "RANGE_EXPAND_150", "STRUCTURE_STEP", "T3_DIST_FAR_025",
     "T3_DIST_FAR_050", "T3_DIST_NEAR_025", "T3_DIST_NEAR_050", "T3_DIST_NEAR_100", "T3_NOT_EXTENDED_075", "T3_SLOPE_NONNEG",
     "T3_SLOPE_STRONG_015", "T3_SLOPE_STRONG_030", "VOL_HIGH_120", "VOL_LOW_080", "ABOVE_PREV_SETTLE", "RTH_OPEN_90"])
t3Len = input.int(5, "T3 length (column t3, before the /)", minval = 1, group = gL)
t3VF  = input.float(0.7, "T3 volume factor (column t3, after the /)", minval = 0.0, maxval = 1.0, step = 0.1, group = gL)
atrLen = input.int(14, "ATR length", minval = 1, group = gP)

gX = "Exit (deployment card)"
slATR   = input.float(1.0, "Stop loss (x ATR of the signal bar, 0 = none)", minval = 0.0, step = 0.25, group = gX)
tpR     = input.float(1.5, "Take profit (x stop distance, 0 = none)", minval = 0.0, step = 0.25, group = gX)
maxBars = input.int(48, "Max bars in trade (48 = DAY: until the flat-by time)", minval = 1, group = gX)

gS = "Session (TopstepX)"
useFlat = input.bool(true, "Flat by time (CT)", group = gS)
flatHH  = input.int(15, "Flat by hour (CT)", minval = 0, maxval = 23, group = gS)
flatMM  = input.int(8, "Flat by minute (CT)", minval = 0, maxval = 59, group = gS)

gR = "Day session (CT): CL 08:00-13:30, GC 07:20-12:30, SI 07:25-12:25, NQ/YM 08:30-15:00"
rthOH = input.int(8, "Day-session open hour", minval = 0, maxval = 23, group = gR)
rthOM = input.int(30, "Day-session open minute", minval = 0, maxval = 59, group = gR)
rthCH = input.int(15, "Settlement hour", minval = 0, maxval = 23, group = gR)
rthCM = input.int(0, "Settlement minute", minval = 0, maxval = 59, group = gR)

gM = "Paired market for MARKET_AGREE (NQ-YM, YM-NQ, GC-SI, SI-GC, CL-NQ)"
pairSym = input.symbol("CME_MINI:YM1!", "Paired market", group = gM)
pairCH  = input.int(15, "Paired market settlement hour (CT)", minval = 0, maxval = 23, group = gM)
pairCM  = input.int(0, "Paired market settlement minute (CT)", minval = 0, maxval = 59, group = gM)

gW = "Window"
fromT = input.time(timestamp("2008-01-01T00:00:00"), "Trade from", group = gW)
toT   = input.time(timestamp("2099-01-01T00:00:00"), "Trade until", group = gW)
showT = input.bool(true, "Show stats table", group = gW)

// ───────────────────────────── helpers
// T3 (Tillson): six cascaded EMAs; T3 = c1*e6 + c2*e5 + c3*e4 + c4*e3
f_t3(src, len, v) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    e4 = ta.ema(e3, len)
    e5 = ta.ema(e4, len)
    e6 = ta.ema(e5, len)
    c1 = -v * v * v
    c2 = 3 * v * v + 3 * v * v * v
    c3 = -6 * v * v - 3 * v - 3 * v * v * v
    c4 = 1 + 3 * v + v * v * v + 3 * v * v
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

// history of one time slot (bar open time in CT minutes), oldest first
type Hist
    array<float> v

f_push(array<float> a, float x, int cap) =>
    a.push(x)
    if a.size() > cap
        a.shift()
    a.size()

f_avgLast(array<float> a, int n) =>
    float r = na
    if a.size() >= n
        r := a.slice(a.size() - n, a.size()).avg()
    r

f_minLast(array<float> a, int n) =>
    float r = na
    if a.size() >= n
        r := a.slice(a.size() - n, a.size()).min()
    r

// median of the last n values: the middle value, or the mean of the two middle values when n is even
f_medLast(array<float> a, int n) =>
    float r = na
    if a.size() >= n
        s = a.slice(a.size() - n, a.size()).copy()
        s.sort(order.ascending)
        int k = int(math.floor(n / 2.0))
        r := n % 2 == 1 ? s.get(k) : (s.get(k - 1) + s.get(k)) / 2.0
    r

// how many of the last n values are strictly below x
f_countBelow(array<float> a, int n, float x) =>
    int k = 0
    int sz = a.size()
    for i = sz - n to sz - 1
        k += a.get(i) < x ? 1 : 0
    k

// z = mean / sd (ddof 1) x sqrt(n) of the last n values
f_z(array<float> a, int n) =>
    float z = na
    int sz = a.size()
    if sz >= n
        sl = a.slice(sz - n, sz)
        float mu = sl.avg()
        float ss = 0.0
        for x in sl
            ss += (x - mu) * (x - mu)
        float sd = math.sqrt(ss / (n - 1))
        if sd > 0
            z := mu / sd * math.sqrt(n)
    z

// paired market: close minus its own previous settlement close (evaluated on the paired symbol)
f_pairDiff(int sStart) =>
    var float sToday = na
    var float sPrev = na
    int m = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
    int k = dayofmonth(time + 7 * 3600000, "America/Chicago")
    if bar_index > 0 and (k != k[1] or time - time[1] >= 120 * 60000)
        sPrev := sToday
        sToday := na
    if m == sStart
        sToday := close
    close - sPrev

// ───────────────────────────── prices, T3, ATR (short side = long rules on mirrored prices)
tLine  = f_t3(close, t3Len, t3VF)
tFast  = f_t3(close, fastLen, fastVF)
tSlow  = f_t3(close, slowLen, slowVF)
atrNow = ta.atr(atrLen)
a1     = atrNow[1]

isLong = sideIn == "Long"
sgn = isLong ? 1.0 : -1.0
float O = isLong ? open : -open
float H = isLong ? high : -low
float L = isLong ? low : -high
float C = isLong ? close : -close
float TL = sgn * tLine
float TF = sgn * tFast
float TS = sgn * tSlow
rng = H - L
d = C - TL
clv = rng > 0 ? (C - L) / rng : 0.0

hh3  = ta.highest(H, 3)[1]
hh5  = ta.highest(H, 5)[1]
hh8  = ta.highest(H, 8)[1]
hh12 = ta.highest(H, 12)[1]
hh20 = ta.highest(H, 20)[1]
nr3  = ta.lowest(rng, 3)[1]
nr5  = ta.lowest(rng, 5)[1]
nr8  = ta.lowest(rng, 8)[1]
sw5  = ta.lowest(L, 5)[2]
sw10 = ta.lowest(L, 10)[2]
mu20 = ta.sma(C, 20)[1]
medRng = ta.median(rng, 20)[1]
medATR = ta.median(a1, 50)

// ───────────────────────────── session clock (FRAMEWORK.html B.8)
barOpenMin  = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
tfMin       = int(timeframe.in_seconds() / 60)
orStart     = int(math.ceil((rthOH * 60 + rthOM) / float(tfMin)) * tfMin)       // OB
or2Start    = orStart + tfMin                                                 // OB2
settleStart = int(math.floor((rthCH * 60 + rthCM - 1) / float(tfMin)) * tfMin)  // SB
imomStart   = settleStart - tfMin                                             // IB
pairSettleStart = int(math.floor((pairCH * 60 + pairCM - 1) / float(tfMin)) * tfMin)
// a session starts at 17:00 CT (the CT date of t + 7 h changes) or after a gap of 120 minutes or more (FRAMEWORK.html B.3)
sKey        = dayofmonth(time + 7 * 3600000, "America/Chicago")
newSession  = bar_index > 0 and (sKey != sKey[1] or time - time[1] >= 120 * 60000)

pairD = request.security(pairSym, timeframe.period, f_pairDiff(pairSettleStart), gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off)

// ───────────────────────────── session anchors (causal: previous sessions only, then this session's bars so far)
var float orH = na
var float orH2 = na
var float orC = na
var float oDay = na
var float settleToday = na
var float settlePrev = na
var float dayHi = na
var float dayLo = na
var bool seenOB = false
var bool seenSB = false
var float hPrev = na
var float lPrev = na
var float rPrev = na
var float meanR20 = na
var bool nr4 = false
var bool nr7 = false
var int volCnt = -1
var bool dTrend = false
var float cumPV = 0.0
var float cumV = 0.0
var bool afterOB = false
var bool brk30Seen = false
var int nB30 = 0
var int nB60 = 0
var int nRet = 0
var int nNB10 = 0
var int nNB15 = 0
var int nV25 = 0
var int nV50 = 0
var int nPDH = 0
var int nPDL = 0
var array<float> rHist = array.new<float>()    // valid day ranges R of past sessions (last 250)
var array<float> sHist = array.new<float>()    // valid settlement closes of past sessions (last 21)
var array<float> xHist = array.new<float>()    // valid volatility ratios x of past sessions (last 250)
var map<int, Hist> sigMap = map.new<int, Hist>()   // per slot: |c - O_day| of past sessions (last 14)
var map<int, Hist> retMap = map.new<int, Hist>()   // per slot: c - o of past sessions (last 40)

if newSession
    settlePrev := settleToday
    bool validPrev = seenOB and seenSB
    rPrev := validPrev ? dayHi - dayLo : na
    hPrev := validPrev ? dayHi : na
    lPrev := validPrev ? dayLo : na
    if validPrev
        f_push(rHist, rPrev, 250)
    if not na(settleToday)
        f_push(sHist, settleToday, 21)
    meanR20 := f_avgLast(rHist, 20)
    float m4 = f_minLast(rHist, 4)
    float m7 = f_minLast(rHist, 7)
    nr4 := not na(rPrev) and not na(m4) and rPrev <= m4
    nr7 := not na(rPrev) and not na(m7) and rPrev <= m7
    float med = f_medLast(rHist, 250)
    float x = rPrev / med
    volCnt := -1
    if not na(x)
        if xHist.size() >= 250
            volCnt := f_countBelow(xHist, 250, x)
        f_push(xHist, x, 250)
    dTrend := not na(settlePrev) and sHist.size() >= 21 and settlePrev - sHist.get(sHist.size() - 21) > 0
    settleToday := na
    orH := na
    orH2 := na
    orC := na
    oDay := na
    dayHi := na
    dayLo := na
    seenOB := false
    seenSB := false
    cumPV := 0.0
    cumV := 0.0
    afterOB := false
    brk30Seen := false
    nB30 := 0
    nB60 := 0
    nRet := 0
    nNB10 := 0
    nNB15 := 0
    nV25 := 0
    nV50 := 0
    nPDH := 0
    nPDL := 0

isOB = barOpenMin == orStart
if isOB
    orH := H
    orC := C
    oDay := O
    seenOB := true
    afterOB := true
if barOpenMin == or2Start
    orH2 := H
if barOpenMin >= orStart and barOpenMin <= settleStart
    dayHi := na(dayHi) ? H : math.max(dayHi, H)
    dayLo := na(dayLo) ? L : math.min(dayLo, L)
if barOpenMin == settleStart
    settleToday := C
    seenSB := true

tp = (H + L + C) / 3.0
if afterOB
    cumPV += tp * volume
    cumV += volume
float vwapS = afterOB and cumV > 0 ? cumPV / cumV : na

Hist sigH = sigMap.get(barOpenMin)
if na(sigH)
    sigH := Hist.new(array.new<float>())
    sigMap.put(barOpenMin, sigH)
float sigma = sigH.v.size() >= 14 ? sigH.v.avg() : na
if not na(oDay)
    f_push(sigH.v, math.abs(C - oDay), 14)

Hist retNext = retMap.get(barOpenMin + tfMin)
float z20 = na
float z40 = na
if not na(retNext)
    z20 := f_z(retNext.v, 20)
    z40 := f_z(retNext.v, 40)
Hist retH = retMap.get(barOpenMin)
if na(retH)
    retH := Hist.new(array.new<float>())
    retMap.put(barOpenMin, retH)
f_push(retH.v, C - O, 40)

// ───────────────────────────── Pool N triggers (FRAMEWORK.html C.7), long form on mirrored prices
inDay = barOpenMin >= orStart and barOpenMin < settleStart
mid   = barOpenMin > orStart and barOpenMin < settleStart
isIB  = barOpenMin == imomStart

orb30Raw = mid and C > orH
nB30 += orb30Raw ? 1 : 0
orb30 = orb30Raw and nB30 == 1
orb60Raw = barOpenMin > or2Start and barOpenMin < settleStart and not na(orH) and not na(orH2) and C > math.max(orH, orH2)
nB60 += orb60Raw ? 1 : 0
retRaw = mid and brk30Seen and L <= orH and C > orH
nRet += retRaw ? 1 : 0
if orb30
    brk30Seen := true

nbBase = na(oDay) or na(settlePrev) ? na : math.max(oDay, settlePrev)
nb10Raw = mid and C > nbBase + 1.0 * sigma
nb15Raw = mid and C > nbBase + 1.5 * sigma
nNB10 += nb10Raw ? 1 : 0
nNB15 += nb15Raw ? 1 : 0
v25Raw = inDay and C > oDay + 0.25 * rPrev
v50Raw = inDay and C > oDay + 0.50 * rPrev
nV25 += v25Raw ? 1 : 0
nV50 += v50Raw ? 1 : 0
pdhRaw = inDay and C > hPrev
nPDH += pdhRaw ? 1 : 0
pdlRaw = inDay and L[1] < lPrev and C > lPrev
nPDL += pdlRaw ? 1 : 0
nxtMin = barOpenMin + tfMin
slotOK = nxtMin >= orStart and nxtMin < settleStart

float TN = str.endswith(nT3Ctx, "_S") ? TS : TF
pullbackN = TN > TN[1] and L[1] <= TN[1] and TN[1] < C[1] and C > H[1]
touch3N   = TN > TN[1] and (L[1] <= TN[1] or L[2] <= TN[2] or L[3] <= TN[3]) and C > TN

bool trigN = switch nTrig
    "ORB_DIR_30"          => isOB and C > O
    "ORB_BREAK_30"        => orb30
    "ORB_BREAK_60"        => orb60Raw and nB60 == 1
    "ORB_RETEST_30"       => retRaw and nRet == 1
    "IMOM_DAY"            => isIB and C > settlePrev
    "IMOM_FIRST"          => isIB and orC > settlePrev
    "IMOM_LARGE"          => isIB and C - settlePrev >= 0.5 * meanR20
    "NB_10"               => nb10Raw and nNB10 == 1
    "NB_15"               => nb15Raw and nNB15 == 1
    "VBO_025"             => v25Raw and nV25 == 1
    "VBO_050"             => v50Raw and nV50 == 1
    "GAP_CONTINUE"        => isOB and oDay - settlePrev >= 0.25 * rPrev and C > O
    "GAP_FADE"            => isOB and oDay - settlePrev <= -0.25 * rPrev and C > O
    "VWAP_RECLAIM"        => mid and C[1] <= vwapS[1] and C > vwapS
    "VWAP_PULLBACK"       => mid and C[1] > vwapS[1] and L <= vwapS and C > vwapS and C > O
    "SLOT_20"             => slotOK and z20 >= 2
    "SLOT_40"             => slotOK and z40 >= 2
    "NR4_DAY_BREAK"       => pdhRaw and nPDH == 1 and nr4
    "NR7_DAY_BREAK"       => pdhRaw and nPDH == 1 and nr7
    "PDH_BREAK"           => pdhRaw and nPDH == 1
    "PDL_RECLAIM"         => pdlRaw and nPDL == 1
    "T3_PULLBACK_BREAK_D" => inDay and pullbackN
    "T3_TOUCH_3BAR_D"     => inDay and touch3N
    "MR_VWAP_2"           => mid and L <= vwapS - 2 * a1 and C > O and rng > 0 and (C - L) >= 0.5 * rng
    "MR_SMA20_2_D"        => inDay and L <= mu20 - 2 * a1 and C > O
    => false

bool t3c = switch nT3Ctx
    "NONE"          => true
    "T3_SLOPE_UP_F" => TF - TF[3] >= 0
    "T3_SLOPE_UP_S" => TS - TS[3] >= 0
    "T3_SIDE_F"     => C > TF
    "T3_SIDE_S"     => C > TS
    "T3_NEAR_F"     => C - TF > 0 and C - TF <= 1.0 * a1
    "T3_NEAR_S"     => C - TS > 0 and C - TS <= 1.0 * a1
    "T3_STRONG_F"   => TF - TF[3] >= 0.15 * a1
    "T3_STRONG_S"   => TS - TS[3] >= 0.15 * a1
    "T3_STACK"      => TF > TS and TS - TS[3] >= 0
    => false

bool mc = switch nMktCtx
    "NONE"         => true
    "VOL_HIGH"     => volCnt >= 167
    "VOL_NOT_LOW"  => volCnt >= 84
    "DAILY_TREND"  => dTrend
    "MARKET_AGREE" => sgn * pairD > 0
    => false

// ───────────────────────────── Pool L triggers and filters (FRAMEWORK.html C.3, C.4)
bool trigL = switch lTrig
    "T3_BODY_CROSS"          => O <= TL and C > TL
    "T3_CLOSE_CROSS"         => C[1] <= TL[1] and C > TL
    "T3_TWO_CLOSE"           => C > TL and C[1] > TL[1] and C[2] <= TL[2]
    "T3_THREE_CLOSE"         => C > TL and C[1] > TL[1] and C[2] > TL[2] and C[3] <= TL[3]
    "T3_WICK_RECLAIM"        => O > TL and L <= TL and C > TL
    "T3_CLEAN_RECLAIM"       => L > TL and L[1] <= TL[1] and TL[1] <= H[1]
    "T3_CROSS_RANGE_BREAK"   => C[1] > TL[1] and C[2] <= TL[2] and C > H[1]
    "T3_PULLBACK_BREAK"      => TL > TL[1] and L[1] <= TL[1] and TL[1] < C[1] and C > H[1]
    "T3_TOUCH_3BAR_TREND"    => TL > TL[1] and (L[1] <= TL[1] or L[2] <= TL[2] or L[3] <= TL[3]) and C > TL
    "T3_SLOPE_TURN"          => TL > TL[1] and TL[1] <= TL[2] and C > TL
    "T3_DISTANCE_RELEASE"    => d > 0 and d > d[1]
    "DONCHIAN_3"             => C > hh3
    "DONCHIAN_5"             => C > hh5
    "DONCHIAN_8"             => C > hh8
    "DONCHIAN_12"            => C > hh12
    "DONCHIAN_20"            => C > hh20
    "PREVBAR_BREAK"          => C > H[1]
    "INSIDE_BAR_BREAK"       => H[1] <= H[2] and L[1] >= L[2] and C > H[1]
    "COMPRESSION_BREAK_3"    => rng[1] <= nr3 and C > hh3
    "COMPRESSION_BREAK_5"    => rng[1] <= nr5 and C > hh5
    "COMPRESSION_BREAK_8"    => rng[1] <= nr8 and C > hh8
    "RANGE_EXPANSION_CLOSE"  => rng > a1 and (C - L) >= 0.75 * rng
    "MOMENTUM_3"             => C > C[3]
    "MOMENTUM_6"             => C > C[6]
    "THREE_BAR_CONTINUATION" => C[1] > C[2] and C[2] > C[3] and C > H[1]
    "GAP_CONTINUATION"       => O > C[1] and C > O
    "TWO_BAR_REVERSAL"       => C[1] < O[1] and C > H[1]
    "OUTSIDE_BAR_REVERSAL"   => H > H[1] and L < L[1] and rng > 0 and (C - L) >= 0.75 * rng
    "SWEEP_RECLAIM_5"        => L[1] < sw5 and C > sw5
    "SWEEP_RECLAIM_10"       => L[1] < sw10 and C > sw10
    "MEAN_REVERSION_2"       => L <= mu20 - 2 * a1 and C > O
    "MEAN_REVERSION_3"       => L <= mu20 - 3 * a1 and C > O
    "ORB_OPEN_BAR"           => isOB and C > O
    "ORB_BREAK"              => orb30
    "IMOM_DAY"               => isIB and C > settlePrev
    "IMOM_FIRST"             => isIB and orC > settlePrev
    => false

bool filtL = switch lFilt
    "NONE"                 => true
    "BODY_35"              => rng > 0 and math.abs(C - O) >= 0.35 * rng
    "BODY_55"              => rng > 0 and math.abs(C - O) >= 0.55 * rng
    "BODY_70"              => rng > 0 and math.abs(C - O) >= 0.70 * rng
    "CLV_55"               => rng > 0 and clv >= 0.55
    "CLV_65"               => rng > 0 and clv >= 0.65
    "CLV_75"               => rng > 0 and clv >= 0.75
    "DIRECTIONAL_BODY"     => C > O
    "FAVOURABLE_WICK_30"   => rng > 0 and (math.min(O, C) - L) >= 0.30 * rng
    "NO_ADVERSE_WICK_20"   => rng > 0 and (H - math.max(O, C)) <= 0.20 * rng
    "GAP_ALIGNED_010"      => O - C[1] >= 0.10 * a1
    "MOMENTUM_2"           => C > C[2]
    "PREV_OPPOSITE_CANDLE" => C[1] < O[1]
    "RANGE_COMPRESS_060"   => rng <= 0.60 * medRng
    "RANGE_EXPAND_125"     => rng >= 1.25 * a1
    "RANGE_EXPAND_150"     => rng >= 1.50 * a1
    "STRUCTURE_STEP"       => L > L[1]
    "T3_DIST_FAR_025"      => d >= 0.25 * a1
    "T3_DIST_FAR_050"      => d >= 0.50 * a1
    "T3_DIST_NEAR_025"     => d > 0 and d <= 0.25 * a1
    "T3_DIST_NEAR_050"     => d > 0 and d <= 0.50 * a1
    "T3_DIST_NEAR_100"     => d > 0 and d <= 1.00 * a1
    "T3_NOT_EXTENDED_075"  => d <= 0.75 * a1
    "T3_SLOPE_NONNEG"      => TL - TL[3] >= 0
    "T3_SLOPE_STRONG_015"  => TL - TL[3] >= 0.15 * a1
    "T3_SLOPE_STRONG_030"  => TL - TL[3] >= 0.30 * a1
    "VOL_HIGH_120"         => a1 >= 1.20 * medATR
    "VOL_LOW_080"          => a1 <= 0.80 * medATR
    "ABOVE_PREV_SETTLE"    => C > settlePrev
    "RTH_OPEN_90"          => barOpenMin >= orStart and barOpenMin < orStart + 90
    => false

signal = poolIn == "L" ? trigL and filtL : trigN and t3c and mc

// ───────────────────────────── per-trade statistics in ATR units (before new entries, so riskATR still belongs to the closed trade)
var float riskATR = na
var int nT = 0
var int nW = 0
var float sumR = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float sumMFE = 0.0
var float sumMAE = 0.0
var float sumBars = 0.0
var int nSL = 0
var int nTP = 0
var int nTM = 0
var int nEOS = 0
var int seen = 0
if strategy.closedtrades > seen
    for i = seen to strategy.closedtrades - 1
        unit = riskATR * syminfo.pointvalue * math.abs(strategy.closedtrades.size(i))
        if unit > 0
            r = strategy.closedtrades.profit(i) / unit
            nT += 1
            nW += r > 0 ? 1 : 0
            sumR += r
            grossW += r > 0 ? r : 0
            grossL += r < 0 ? -r : 0
            sumMFE += strategy.closedtrades.max_runup(i) / unit
            sumMAE += strategy.closedtrades.max_drawdown(i) / unit
            sumBars += strategy.closedtrades.exit_bar_index(i) - strategy.closedtrades.entry_bar_index(i)
            cm = strategy.closedtrades.exit_comment(i)
            nSL += cm == "SL" ? 1 : 0
            nTP += cm == "TP" ? 1 : 0
            nTM += cm == "TIME" ? 1 : 0
            nEOS += cm == "EOS" ? 1 : 0
    seen := strategy.closedtrades

// ───────────────────────────── execution (FRAMEWORK.html B.3 / B.4)
inWindow = time >= fromT and time <= toT
// a bar that closes after the flat-by time and opens before 17:00 CT may not hold a position
flatMin   = flatHH * 60 + flatMM
afterFlat = useFlat and barOpenMin < 17 * 60 and barOpenMin + tfMin > flatMin
lastTradable = useFlat and not afterFlat and barOpenMin < 17 * 60 and barOpenMin + 2 * tfMin > flatMin
lastOfSession = session.islastbar or time_close >= time_close("D") or lastTradable or afterFlat
canEnter = signal and inWindow and strategy.position_size == 0 and not lastOfSession and atrNow > 0

var float slPx = na
var float tpPx = na
if canEnter
    slTicks = slATR > 0 ? math.max(1, math.round(slATR * atrNow / syminfo.mintick)) : na
    tpTicks = slATR > 0 and tpR > 0 ? math.max(1, math.round(tpR * slTicks)) : na
    strategy.entry("E", isLong ? strategy.long : strategy.short)
    strategy.exit("X", "E", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")
    riskATR := atrNow

if strategy.position_size != 0
    ep = strategy.opentrades.entry_price(0)
    eb = strategy.opentrades.entry_bar_index(0)
    slT = math.max(1, math.round(slATR * riskATR / syminfo.mintick))
    slPx := slATR > 0 ? ep - sgn * slT * syminfo.mintick : na
    tpPx := slATR > 0 and tpR > 0 ? ep + sgn * math.max(1, math.round(tpR * slT)) * syminfo.mintick : na
    if lastOfSession
        strategy.close("E", comment = "EOS", immediately = true)
    else if bar_index >= eb + maxBars - 1
        strategy.close("E", comment = "TIME")
else
    slPx := na
    tpPx := na

// ───────────────────────────── visuals
plot(poolIn == "L" ? tLine : tFast, "T3 (Pool L row / FAST)", color = color.orange, linewidth = 2)
plot(poolIn == "N" ? tSlow : na, "T3 SLOW", color = color.purple, linewidth = 1)
plot(sgn * vwapS, "VWAP (day session)", color = color.new(color.aqua, 30), style = plot.style_linebr)
plotshape(signal and inWindow, "Signal", style = isLong ? shape.triangleup : shape.triangledown,
     location = isLong ? location.belowbar : location.abovebar, color = isLong ? color.teal : color.red, size = size.tiny)
plot(slPx, "Stop", color = color.red, style = plot.style_linebr)
plot(tpPx, "Target", color = color.green, style = plot.style_linebr)

var table tb = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 15), border_width = 1)
f_row(row, k, v) =>
    table.cell(tb, 0, row, k, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, row, v, text_color = color.white, text_size = size.small)
if showT and barstate.islast
    setup = poolIn == "L" ? "L: " + lTrig + " + " + lFilt + " T3 " + str.tostring(t3Len) + "/" + str.tostring(t3VF) :
         "N: " + nTrig + " + " + nT3Ctx + " + " + nMktCtx
    f_row(0, "Setup", setup + " " + sideIn)
    f_row(1, "Trades", str.tostring(nT))
    f_row(2, "Win rate", nT > 0 ? str.tostring(100.0 * nW / nT, "#.0") + "%" : "-")
    f_row(3, "Net mean R (ATR)", nT > 0 ? str.tostring(sumR / nT, "#.000") : "-")
    f_row(4, "Profit factor", grossL > 0 ? str.tostring(grossW / grossL, "#.00") : "-")
    f_row(5, "Mean MFE (ATR)", nT > 0 ? str.tostring(sumMFE / nT, "#.00") : "-")
    f_row(6, "Mean MAE (ATR)", nT > 0 ? str.tostring(sumMAE / nT, "#.00") : "-")
    f_row(7, "Mean bars held", nT > 0 ? str.tostring(sumBars / nT, "#.0") : "-")
    f_row(8, "Exits SL/TP/TIME/EOS", str.tostring(nSL) + "/" + str.tostring(nTP) + "/" + str.tostring(nTM) + "/" + str.tostring(nEOS))
    f_row(9, "FAST / SLOW / ATR", str.tostring(fastLen) + "/" + str.tostring(fastVF) + " · " + str.tostring(slowLen) + "/" + str.tostring(slowVF) + " · " + str.tostring(atrLen))
    f_row(10, "SL x ATR / TP x stop / max bars", str.tostring(slATR) + " / " + str.tostring(tpR) + " / " + str.tostring(maxBars))

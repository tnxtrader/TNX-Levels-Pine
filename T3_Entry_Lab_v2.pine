//@version=6
// T3 Entry Lab v2 — executes one registry candidate (trigger + filter + side + T3) with the framework's exit rules.
// Rules and execution are identical to t3lab/t3lab/core.py and t3lab/t3lab/engine.py (FRAMEWORK.html B.2, B.3, B.7, B.8).
// Chart: the instrument's continuous contract, 30-minute bars, full electronic (ETH) session.
// Properties: commission per contract = the card's Fees_round_trip_usd / 2 (cash per contract, per side); slippage = 1 tick.
strategy("T3 Entry Lab v2", shorttitle = "T3Lab v2", overlay = true, pyramiding = 0, calc_on_every_tick = false,
     process_orders_on_close = false, default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5, slippage = 1,
     use_bar_magnifier = false, max_bars_back = 500)

// ───────────────────────────── inputs
gE = "Entry (deployment card)"
trigName = input.string("T3_CLOSE_CROSS", "Trigger", group = gE, options = ["T3_BODY_CROSS", "T3_CLOSE_CROSS", "T3_TWO_CLOSE",
     "T3_THREE_CLOSE", "T3_WICK_RECLAIM", "T3_CLEAN_RECLAIM", "T3_CROSS_RANGE_BREAK", "T3_PULLBACK_BREAK", "T3_TOUCH_3BAR_TREND",
     "T3_SLOPE_TURN", "T3_DISTANCE_RELEASE", "DONCHIAN_3", "DONCHIAN_5", "DONCHIAN_8", "DONCHIAN_12", "DONCHIAN_20",
     "PREVBAR_BREAK", "INSIDE_BAR_BREAK", "COMPRESSION_BREAK_3", "COMPRESSION_BREAK_5", "COMPRESSION_BREAK_8",
     "RANGE_EXPANSION_CLOSE", "MOMENTUM_3", "MOMENTUM_6", "THREE_BAR_CONTINUATION", "GAP_CONTINUATION", "TWO_BAR_REVERSAL",
     "OUTSIDE_BAR_REVERSAL", "SWEEP_RECLAIM_5", "SWEEP_RECLAIM_10", "MEAN_REVERSION_2", "MEAN_REVERSION_3"])
filtName = input.string("NONE", "Filter", group = gE, options = ["NONE", "BODY_35", "BODY_55", "BODY_70", "CLV_55", "CLV_65",
     "CLV_75", "DIRECTIONAL_BODY", "FAVOURABLE_WICK_30", "NO_ADVERSE_WICK_20", "GAP_ALIGNED_010", "MOMENTUM_2",
     "PREV_OPPOSITE_CANDLE", "RANGE_COMPRESS_060", "RANGE_EXPAND_125", "RANGE_EXPAND_150", "STRUCTURE_STEP", "T3_DIST_FAR_025",
     "T3_DIST_FAR_050", "T3_DIST_NEAR_025", "T3_DIST_NEAR_050", "T3_DIST_NEAR_100", "T3_NOT_EXTENDED_075", "T3_SLOPE_NONNEG",
     "T3_SLOPE_STRONG_015", "T3_SLOPE_STRONG_030", "VOL_HIGH_120", "VOL_LOW_080"])
sideIn = input.string("Long", "Side", options = ["Long", "Short"], group = gE)
t3Len  = input.int(3, "T3 length", minval = 1, group = gE)
t3VF   = input.float(0.7, "T3 volume factor", minval = 0.0, maxval = 1.0, step = 0.1, group = gE)
atrLen = input.int(14, "ATR length", minval = 1, group = gE)

gX = "Exit (deployment card)"
slATR   = input.float(1.0, "Stop loss (x ATR of the signal bar, 0 = none)", minval = 0.0, step = 0.25, group = gX)
tpR     = input.float(1.5, "Take profit (x stop distance, 0 = none)", minval = 0.0, step = 0.25, group = gX)
maxBars = input.int(8, "Max bars in trade", minval = 1, group = gX)

gS = "Session (TopstepX)"
useFlat = input.bool(true, "Flat by time (CT)", group = gS)
flatHH  = input.int(15, "Flat by hour (CT)", minval = 0, maxval = 23, group = gS)
flatMM  = input.int(8, "Flat by minute (CT)", minval = 0, maxval = 59, group = gS)

gW = "Window"
fromT = input.time(timestamp("2008-01-01T00:00:00"), "Trade from", group = gW)
toT   = input.time(timestamp("2099-01-01T00:00:00"), "Trade until", group = gW)
showT = input.bool(true, "Show stats table", group = gW)

// ───────────────────────────── indicators
// T3 (Tillson): GD(x) = (1+v)EMA(x) - v EMA(EMA(x)); T3 = GD(GD(GD(close)))
f_t3(src, len, v) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    e4 = ta.ema(e3, len)
    e5 = ta.ema(e4, len)
    e6 = ta.ema(e5, len)
    c1 = -v * v * v
    c2 = 3 * v * v + 3 * v * v * v
    c3 = -6 * v * v - 3 * v - 3 * v * v * v
    c4 = 1 + 3 * v + v * v * v + 3 * v * v
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

t3line = f_t3(close, t3Len, t3VF)
atrNow = ta.atr(atrLen)
a1     = atrNow[1]

// short side = long rules on mirrored prices (-open, -low, -high, -close) and -T3
isLong = sideIn == "Long"
sgn = isLong ? 1.0 : -1.0
float O = isLong ? open : -open
float H = isLong ? high : -low
float L = isLong ? low : -high
float C = isLong ? close : -close
float T = sgn * t3line
rng = H - L
d = C - T
clv = rng > 0 ? (C - L) / rng : 0.0

// rolling series are computed on every bar
hh3  = ta.highest(H, 3)[1]
hh5  = ta.highest(H, 5)[1]
hh8  = ta.highest(H, 8)[1]
hh12 = ta.highest(H, 12)[1]
hh20 = ta.highest(H, 20)[1]
nr3  = ta.lowest(rng, 3)[1]
nr5  = ta.lowest(rng, 5)[1]
nr8  = ta.lowest(rng, 8)[1]
sw5  = ta.lowest(L, 5)[2]
sw10 = ta.lowest(L, 10)[2]
mu20 = ta.sma(C, 20)[1]
medRng = ta.median(rng, 20)[1]
medATR = ta.median(a1, 50)

bool trig = switch trigName
    "T3_BODY_CROSS"          => O <= T and C > T
    "T3_CLOSE_CROSS"         => C[1] <= T[1] and C > T
    "T3_TWO_CLOSE"           => C > T and C[1] > T[1] and C[2] <= T[2]
    "T3_THREE_CLOSE"         => C > T and C[1] > T[1] and C[2] > T[2] and C[3] <= T[3]
    "T3_WICK_RECLAIM"        => O > T and L <= T and C > T
    "T3_CLEAN_RECLAIM"       => L > T and L[1] <= T[1] and T[1] <= H[1]
    "T3_CROSS_RANGE_BREAK"   => C[1] > T[1] and C[2] <= T[2] and C > H[1]
    "T3_PULLBACK_BREAK"      => T > T[1] and L[1] <= T[1] and T[1] < C[1] and C > H[1]
    "T3_TOUCH_3BAR_TREND"    => T > T[1] and (L[1] <= T[1] or L[2] <= T[2] or L[3] <= T[3]) and C > T
    "T3_SLOPE_TURN"          => T > T[1] and T[1] <= T[2] and C > T
    "T3_DISTANCE_RELEASE"    => d > 0 and d > d[1]
    "DONCHIAN_3"             => C > hh3
    "DONCHIAN_5"             => C > hh5
    "DONCHIAN_8"             => C > hh8
    "DONCHIAN_12"            => C > hh12
    "DONCHIAN_20"            => C > hh20
    "PREVBAR_BREAK"          => C > H[1]
    "INSIDE_BAR_BREAK"       => H[1] <= H[2] and L[1] >= L[2] and C > H[1]
    "COMPRESSION_BREAK_3"    => rng[1] <= nr3 and C > hh3
    "COMPRESSION_BREAK_5"    => rng[1] <= nr5 and C > hh5
    "COMPRESSION_BREAK_8"    => rng[1] <= nr8 and C > hh8
    "RANGE_EXPANSION_CLOSE"  => rng > a1 and (C - L) >= 0.75 * rng
    "MOMENTUM_3"             => C > C[3]
    "MOMENTUM_6"             => C > C[6]
    "THREE_BAR_CONTINUATION" => C[1] > C[2] and C[2] > C[3] and C > H[1]
    "GAP_CONTINUATION"       => O > C[1] and C > O
    "TWO_BAR_REVERSAL"       => C[1] < O[1] and C > H[1]
    "OUTSIDE_BAR_REVERSAL"   => H > H[1] and L < L[1] and rng > 0 and (C - L) >= 0.75 * rng
    "SWEEP_RECLAIM_5"        => L[1] < sw5 and C > sw5
    "SWEEP_RECLAIM_10"       => L[1] < sw10 and C > sw10
    "MEAN_REVERSION_2"       => L <= mu20 - 2 * a1 and C > O
    "MEAN_REVERSION_3"       => L <= mu20 - 3 * a1 and C > O
    => false

bool filt = switch filtName
    "NONE"                 => true
    "BODY_35"              => rng > 0 and math.abs(C - O) >= 0.35 * rng
    "BODY_55"              => rng > 0 and math.abs(C - O) >= 0.55 * rng
    "BODY_70"              => rng > 0 and math.abs(C - O) >= 0.70 * rng
    "CLV_55"               => rng > 0 and clv >= 0.55
    "CLV_65"               => rng > 0 and clv >= 0.65
    "CLV_75"               => rng > 0 and clv >= 0.75
    "DIRECTIONAL_BODY"     => C > O
    "FAVOURABLE_WICK_30"   => rng > 0 and (math.min(O, C) - L) >= 0.30 * rng
    "NO_ADVERSE_WICK_20"   => rng > 0 and (H - math.max(O, C)) <= 0.20 * rng
    "GAP_ALIGNED_010"      => O - C[1] >= 0.10 * a1
    "MOMENTUM_2"           => C > C[2]
    "PREV_OPPOSITE_CANDLE" => C[1] < O[1]
    "RANGE_COMPRESS_060"   => rng <= 0.60 * medRng
    "RANGE_EXPAND_125"     => rng >= 1.25 * a1
    "RANGE_EXPAND_150"     => rng >= 1.50 * a1
    "STRUCTURE_STEP"       => L > L[1]
    "T3_DIST_FAR_025"      => d >= 0.25 * a1
    "T3_DIST_FAR_050"      => d >= 0.50 * a1
    "T3_DIST_NEAR_025"     => d > 0 and d <= 0.25 * a1
    "T3_DIST_NEAR_050"     => d > 0 and d <= 0.50 * a1
    "T3_DIST_NEAR_100"     => d > 0 and d <= 1.00 * a1
    "T3_NOT_EXTENDED_075"  => d <= 0.75 * a1
    "T3_SLOPE_NONNEG"      => T - T[3] >= 0
    "T3_SLOPE_STRONG_015"  => T - T[3] >= 0.15 * a1
    "T3_SLOPE_STRONG_030"  => T - T[3] >= 0.30 * a1
    "VOL_HIGH_120"         => a1 >= 1.20 * medATR
    "VOL_LOW_080"          => a1 <= 0.80 * medATR
    => false

// ───────────────────────────── per-trade statistics in ATR units (before new entries, so riskATR still belongs to the closed trade)
var float riskATR = na
var int nT = 0
var int nW = 0
var float sumR = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float sumMFE = 0.0
var float sumMAE = 0.0
var float sumBars = 0.0
var int nSL = 0
var int nTP = 0
var int nTM = 0
var int nEOS = 0
var int seen = 0
if strategy.closedtrades > seen
    for i = seen to strategy.closedtrades - 1
        unit = riskATR * syminfo.pointvalue * math.abs(strategy.closedtrades.size(i))
        if unit > 0
            r = strategy.closedtrades.profit(i) / unit
            nT += 1
            nW += r > 0 ? 1 : 0
            sumR += r
            grossW += r > 0 ? r : 0
            grossL += r < 0 ? -r : 0
            sumMFE += strategy.closedtrades.max_runup(i) / unit
            sumMAE += strategy.closedtrades.max_drawdown(i) / unit
            sumBars += strategy.closedtrades.exit_bar_index(i) - strategy.closedtrades.entry_bar_index(i)
            cm = strategy.closedtrades.exit_comment(i)
            nSL += cm == "SL" ? 1 : 0
            nTP += cm == "TP" ? 1 : 0
            nTM += cm == "TIME" ? 1 : 0
            nEOS += cm == "EOS" ? 1 : 0
    seen := strategy.closedtrades

// ───────────────────────────── execution (FRAMEWORK.html B.2 / B.3)
inWindow = time >= fromT and time <= toT
// a bar that closes after the flat-by time and opens before 17:00 CT may not hold a position (FRAMEWORK.html B.2)
openMin  = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
barMin   = timeframe.in_seconds() / 60
flatMin  = flatHH * 60 + flatMM
afterFlat = useFlat and openMin < 17 * 60 and openMin + barMin > flatMin
lastTradable = useFlat and not afterFlat and openMin < 17 * 60 and openMin + 2 * barMin > flatMin
lastOfSession = session.islastbar or time_close >= time_close("D") or lastTradable or afterFlat
signal = trig and filt
canEnter = signal and inWindow and strategy.position_size == 0 and not lastOfSession and atrNow > 0

var float slPx = na
var float tpPx = na
if canEnter
    slTicks = slATR > 0 ? math.max(1, math.round(slATR * atrNow / syminfo.mintick)) : na
    tpTicks = slATR > 0 and tpR > 0 ? math.max(1, math.round(tpR * slTicks)) : na
    strategy.entry("E", isLong ? strategy.long : strategy.short)
    strategy.exit("X", "E", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")
    riskATR := atrNow

if strategy.position_size != 0
    ep = strategy.opentrades.entry_price(0)
    eb = strategy.opentrades.entry_bar_index(0)
    slT = math.max(1, math.round(slATR * riskATR / syminfo.mintick))
    slPx := slATR > 0 ? ep - sgn * slT * syminfo.mintick : na
    tpPx := slATR > 0 and tpR > 0 ? ep + sgn * math.max(1, math.round(tpR * slT)) * syminfo.mintick : na
    if lastOfSession
        strategy.close("E", comment = "EOS", immediately = true)
    else if bar_index >= eb + maxBars - 1
        strategy.close("E", comment = "TIME")
else
    slPx := na
    tpPx := na

// ───────────────────────────── visuals
plot(t3line, "T3", color = color.orange, linewidth = 2)
plotshape(signal and inWindow, "Signal", style = isLong ? shape.triangleup : shape.triangledown,
     location = isLong ? location.belowbar : location.abovebar, color = isLong ? color.teal : color.red, size = size.tiny)
plot(slPx, "Stop", color = color.red, style = plot.style_linebr)
plot(tpPx, "Target", color = color.green, style = plot.style_linebr)

var table tb = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 15), border_width = 1)
f_row(row, k, v) =>
    table.cell(tb, 0, row, k, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, row, v, text_color = color.white, text_size = size.small)
if showT and barstate.islast
    f_row(0, "Setup", trigName + " + " + filtName + " " + sideIn)
    f_row(1, "Trades", str.tostring(nT))
    f_row(2, "Win rate", nT > 0 ? str.tostring(100.0 * nW / nT, "#.0") + "%" : "-")
    f_row(3, "Net mean R (ATR)", nT > 0 ? str.tostring(sumR / nT, "#.000") : "-")
    f_row(4, "Profit factor", grossL > 0 ? str.tostring(grossW / grossL, "#.00") : "-")
    f_row(5, "Mean MFE (ATR)", nT > 0 ? str.tostring(sumMFE / nT, "#.00") : "-")
    f_row(6, "Mean MAE (ATR)", nT > 0 ? str.tostring(sumMAE / nT, "#.00") : "-")
    f_row(7, "Mean bars held", nT > 0 ? str.tostring(sumBars / nT, "#.0") : "-")
    f_row(8, "Exits SL/TP/TIME/EOS", str.tostring(nSL) + "/" + str.tostring(nTP) + "/" + str.tostring(nTM) + "/" + str.tostring(nEOS))
    f_row(9, "T3 / ATR", str.tostring(t3Len) + " / " + str.tostring(t3VF) + " / " + str.tostring(atrLen))
    f_row(10, "SL x ATR / TP x stop / max bars", str.tostring(slATR) + " / " + str.tostring(tpR) + " / " + str.tostring(maxBars))

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same settings as the original TNXCVDPro.dll (read from its metadata on 2026-10-08):
       .NET 10 Windows, Release (optimized), TradingPlatform.BusinessLayer 1.146.7.0, System.Drawing.Common 9.0.0.0.
       Build: dotnet build -c Release -->
  <PropertyGroup>
    <AssemblyName>TNXCVDPro</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerApi_1_146_7)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" ExcludeAssets="runtime" />
    <!-- shared code (P4): reused paths and work arrays - same pixels -->
    <Compile Include="..\..\TNX-COMMON\GdiCache.cs" Link="common\GdiCache.cs" />
    <Compile Include="..\..\TNX-COMMON\PictureArrays.cs" Link="common\PictureArrays.cs" />
    <Compile Include="..\..\TNX-COMMON\TnxErrors.cs" Link="common\TnxErrors.cs" />
  </ItemGroup>
</Project>
